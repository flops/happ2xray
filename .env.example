# Copy to .env next to happ_routing_to_xray.sh to use it.

# Required unless passed as the script's first argument. The Remnawave
# subscription URL to read the Happ routing profile and proxy links from.
XRAY_SUBSCRIPTION_URL=

# Base directory of an Xray installation. When set, generated JSON configs
# are written to $XRAY_DIR_PATH/configs/ and downloaded geoip/geosite .dat
# files go to $XRAY_DIR_PATH/dat/, instead of the current directory.
XRAY_DIR_PATH=/opt/etc/xray

# Optional. Pins the x-hwid header sent with every subscription request, for
# panels with Remnawave's "HWID device limit" feature enabled (without a
# valid x-hwid, those return 404). Must match /^[a-zA-Z0-9=-]{10,64}$/.
# If left unset, one is derived from this device (hostname, kernel release/
# arch, NIC MAC address -- not random) once and cached in .hwid next to the
# script, and reused on every later run -- the HWID must stay stable across
# runs, since Remnawave counts/tracks devices by it. Only set this if you
# already have a specific HWID tied to this device (e.g. from a HWID link).
#XRAY_HWID=

# Optional. Tag name for the balancer that "proxy"-kind rules route through
# (default: proxy).
XRAY_BALANCER_TAG=proxy

# Optional. Strategy type for that balancer (default: leastPing).
# Other Xray-core options: random, roundRobin, leastLoad.
XRAY_BALANCER_STRATEGY=leastPing

# Optional. Observatory settings leastPing uses to rank outbounds by latency.
XRAY_PROBE_URL=https://www.gstatic.com/generate_204
XRAY_PROBE_INTERVAL=10s

# Optional. Output file paths, as an alternative to passing them as script
# arguments (an argument, where given, overrides its env var here). Leave
# these commented out (as below) to use the defaults: <base>/configs/
# 01_dns_happ.json, 02_outbounds_happ.json, 03_observatory_happ.json,
# 04_routing_happ.json. Point two or more of these at the SAME path to get
# one combined config file instead of four separate ones -- they get merged
# in generation order (dns, then outbounds, then observatory, then routing)
# rather than the last write clobbering the rest. Uncomment one set to an
# empty string (e.g. XRAY_DNS_FILE=, not commented out) to skip generating
# that file entirely instead of falling back to its default.
#XRAY_DNS_FILE=
#XRAY_OUTBOUNDS_FILE=
#XRAY_OBSERVATORY_FILE=
#XRAY_ROUTING_FILE=

# Used by happ_watch.sh only.
# Optional. How often (minutes) `happ_watch.sh -watch` checks for subscription
# changes when no interval is given on the command line (default: 60).
XRAY_WATCH_INTERVAL_MINUTES=60
# Optional. Crontab file happ_watch.sh edits for -watch/-stop (default:
# /opt/etc/crontabs/root).
XRAY_CRONTAB=/opt/etc/crontabs/root
